# Build-time config (exported before `dx serve` / `dx bundle`).
# Leave USE_EMULATOR=1 to run against the local Firebase Emulator Suite.
USE_EMULATOR=1
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Hosted sign-in page and functions (production example)
AUTH_PAGE_URL=https://<project-id>.firebaseapp.com/auth.html
FUNCTIONS_BASE_URL=https://asia-northeast3-<project-id>.cloudfunctions.net
# Web banner (optional)
ADSENSE_CLIENT=
ADSENSE_SLOT=
